# Ogre Core Resources
[OgreInternal]
FileSystem=@OGRE_MEDIA_DIR@/Main
FileSystem=@OGRE_MEDIA_DIR@/RTShaderLib
FileSystem=@OGRE_MEDIA_DIR@/Terrain/

# Resources required by OgreBites::Trays
[Essential]
Zip=@OGRE_MEDIA_DIR@/packs/SdkTrays.zip
Zip=@OGRE_MEDIA_DIR@/packs/profiler.zip

# this line will end up in the [Essential] group
FileSystem=@OGRE_MEDIA_DIR@/thumbnails

# Common sample resources needed by many of the samples.
# Rarely used resources should be separately loaded by the
# samples which require them.
[General]
# PBR media must come before the scripts that reference it
FileSystem=@OGRE_MEDIA_DIR@/PBR
FileSystem=@OGRE_MEDIA_DIR@/PBR/filament

FileSystem=./assets/materials
FileSystem=./assets/meshes
FileSystem=./assets/textures
FileSystem=./shaders

FileSystem=@OGRE_MEDIA_DIR@/materials/programs/GLSL
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/GLSL120
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/GLSL150
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/GLSL400
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/GLSLES
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/SPIRV
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/Cg
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/HLSL
FileSystem=@OGRE_MEDIA_DIR@/materials/programs/HLSL_Cg
FileSystem=@OGRE_MEDIA_DIR@/materials/scripts
FileSystem=@OGRE_MEDIA_DIR@/materials/textures
FileSystem=@OGRE_MEDIA_DIR@/materials/textures/terrain
FileSystem=@OGRE_MEDIA_DIR@/models
FileSystem=@OGRE_MEDIA_DIR@/particle
FileSystem=@OGRE_MEDIA_DIR@/DeferredShadingMedia
FileSystem=@OGRE_MEDIA_DIR@/DeferredShadingMedia/DeferredShading/post
FileSystem=@OGRE_MEDIA_DIR@/PCZAppMedia
FileSystem=@OGRE_MEDIA_DIR@/materials/scripts/SSAO
FileSystem=@OGRE_MEDIA_DIR@/materials/textures/SSAO
FileSystem=@OGRE_MEDIA_DIR@/volumeTerrain
FileSystem=@OGRE_MEDIA_DIR@/CSMShadows
Zip=@OGRE_MEDIA_DIR@/packs/cubemap.zip
Zip=@OGRE_MEDIA_DIR@/packs/cubemapsJS.zip
Zip=@OGRE_MEDIA_DIR@/packs/dragon.zip
Zip=@OGRE_MEDIA_DIR@/packs/fresneldemo.zip
Zip=@OGRE_MEDIA_DIR@/packs/ogredance.zip
Zip=@OGRE_MEDIA_DIR@/packs/Sinbad.zip
Zip=@OGRE_MEDIA_DIR@/packs/skybox.zip
Zip=@OGRE_MEDIA_DIR@/volumeTerrain/volumeTerrainBig.zip

Zip=@OGRE_MEDIA_DIR@/packs/DamagedHelmet.zip
Zip=@OGRE_MEDIA_DIR@/packs/filament_shaders.zip

[BSPWorld]
Zip=@OGRE_MEDIA_DIR@/packs/oa_rpg3dm2.pk3
Zip=@OGRE_MEDIA_DIR@/packs/ogretestmap.zip
