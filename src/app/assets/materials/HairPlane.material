material HairPlane
{
    technique
    {
        pass
        {
            lighting on
            shading gouraud
            cull_hardware none
            // Формат цвета здесь: Сomponent (Красный Зеленый Синий) [Альфа]
            ambient 0.0 0.3 0.35
            diffuse 0.0 0.6 0.7
            specular 0.5 0.5 0.5 1.0 10.0
        }
    }
}

material HairSphere
{
    technique
    {
        pass
        {
            lighting on
            shading gouraud
            cull_hardware none
            texture_unit
            {
                texture HairSphere_hair_allocation_map.png
                filtering bilinear
            }
        }
    }
}
