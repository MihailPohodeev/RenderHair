// 1. ОБЪЯВЛЯЕМ ВЕРТЕКСНЫЙ ШЕЙДЕР
vertex_program MyHairVS_GLSL glsl
{
    source HairVertex.glsl

    // Ogre автоматически передаст матрицу камеры (просмотра-проекции) в шейдер
    default_params
    {
        param_named_auto viewProjMatrix viewproj_matrix
    }
}

// 2. ОБЪЯВЛЯЕМ ФРАГМЕНТНЫЙ (ПИКСЕЛЬНЫЙ) ШЕЙДЕР
fragment_program MyHairFS_GLSL glsl
{
    source HairFragment.glsl
    default_params
    {
        param_named_auto nodes_per_hair fp_custom 0
        param_named top_color float3 1.0 0.0 0.0
        param_named down_color float3 0.0 0.0 1.0
    }
}

// 3. СОЗДАЕМ МАТЕРИАЛ, КОТОРЫЙ ИХ СВЯЗЫВАЕТ
material MyHairMaterial
{
    technique
    {
        pass
        {
            lighting off
            point_size 3.0
            vertex_program_ref MyHairVS_GLSL
            {
            }
            fragment_program_ref MyHairFS_GLSL
            {
            }
        }
    }
}
